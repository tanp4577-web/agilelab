pipeline {
    agent any

    environment {
        IMAGE_TAG         = "v${BUILD_NUMBER}"
        DOCKERHUB_CREDS   = 'dockerhub-credentials-id'
        DOCKERHUB_USER    = 'tanp77'
    }

    stages {
        
        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Continuous Integration (Testing)') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                    PYTHONPATH=. python3 -m pytest
                '''
            }
        }


        stage('Build & Push Container') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${DOCKERHUB_CREDS}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                        sh "docker build -t ${DOCKERHUB_USER}/calculator-app:${IMAGE_TAG} ."
                        sh "docker push ${DOCKERHUB_USER}/calculator-app:${IMAGE_TAG}"
                    }
                }
            }
        }

        
        stage('Local Port Expose Deployment') {
            steps {
                sh """
                    docker rm -f calculator-local-run || true
                    docker run -d -p 8080:80 --name calculator-local-run ${DOCKERHUB_USER}/calculator-app:${IMAGE_TAG}
                    echo "Application successfully running on http://localhost:8080"
                """
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
